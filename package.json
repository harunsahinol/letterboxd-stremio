{
  "name": "letterboxd-stremio-addon",
  "version": "1.4.0",
  "description": "Letterboxd watchlists and lists as Stremio catalogs, with ratings and hide-watched. Multi-user, free to host.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://letterboxd-stremio.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harunsahinol/letterboxd-stremio.git"
  },
  "keywords": [
    "letterboxd",
    "letterboxd-lists",
    "stremio",
    "stremio-addon",
    "watchlist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/smoke.js",
    "deploy:cf": "npx wrangler deploy",
    "deploy:netlify": "npx netlify-cli deploy --prod"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.12"
  }
}
